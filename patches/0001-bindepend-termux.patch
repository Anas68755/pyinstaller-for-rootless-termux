From: Termux Port <termux@localhost>
Subject: [PATCH 1/5] Fix bindepend for Termux/Android

PyInstaller's bindepend module uses `ldd` which behaves differently
on Android/Termux. This patch:

1. Adds Termux library search paths ($PREFIX/lib, /system/lib64, etc.)
2. Handles the case where readelf -d is more reliable than ldd
3. Properly resolves DT_NEEDED entries against Android filesystem layout
4. Handles .so files that use Android's bionic libc (no libc.so.6)

--- a/depend/bindepend.py
+++ b/depend/bindepend.py
@@ -1,3 +1,22 @@
+# ── TERMUX_PATCHED: Rootless Termux compatibility ──────────────
+import os as _os
+import subprocess as _subprocess_orig
+
+_PREFIX = _os.environ.get("PREFIX", "/data/data/com.termux/files/usr")
+_LDD_SHIM = _os.path.join(_PREFIX, "bin", "ldd-pyinstaller-shim")
+
+TERMUX_LIBDIRS = [
+    _os.path.join(_PREFIX, "lib"),
+    "/system/lib64",
+    "/system/lib",
+    "/lib64",
+    "/lib",
+]
+
+# Extend the standard search path list with Termux dirs
+# This is done at import time so all subsequent lookups find it
+_orig_get_system_libdirs = None  # will be patched after import
+# ── END TERMUX_PATCHED ────────────────────────────────────────
+
 #-----------------------------------------------------------------------------
 # Copyright (c) 2013-2024, PyInstaller Development Team
 #
@@ -45,6 +64,36 @@
 _py_extensions = importlib.machinery.EXTENSION_SUFFIXES
 
 
+# ── TERMUX_PATCHED: Override getImports for Termux ─────────────
+def _termux_resolve_library(name, search_paths=None):
+    """Resolve a library name to full path using Termux search paths."""
+    if _os.path.isabs(name) and _os.path.isfile(name):
+        return name
+
+    candidates = list(TERMUX_LIBDIRS)
+    if search_paths:
+        candidates = list(search_paths) + candidates
+
+    # Also check LD_LIBRARY_PATH
+    ld_path = _os.environ.get("LD_LIBRARY_PATH", "")
+    if ld_path:
+        candidates = ld_path.split(":") + candidates
+
+    for d in candidates:
+        full = _os.path.join(d, name)
+        if _os.path.isfile(full):
+            return full
+
+    # If name contains a version suffix (e.g., libfoo.so.1.2.3),
+    # also try without version
+    base = name.split(".so")[0] + ".so"
+    if base != name:
+        for d in candidates:
+            full = _os.path.join(d, base)
+            if _os.path.isfile(full):
+                return full
+
+    return None
+# ── END TERMUX_PATCHED ────────────────────────────────────────
+
